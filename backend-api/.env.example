APP_NAME=ACM Training Platform API
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://acm:acm_local_password@localhost:5432/acm_platform
REDIS_URL=redis://:redis_local_password@localhost:6379/0
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=acm-training-platform
JWT_AUDIENCE=acm-platform-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=codearena.refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=8
REGISTER_RATE_LIMIT_IP_ATTEMPTS=10
REGISTER_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=http://localhost:5173
TEST_DATABASE_URL=postgresql+asyncpg://acm_test:acm_test_password@localhost:55432/acm_platform_test
