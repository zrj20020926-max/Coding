# Copy to .env for Docker Compose. Replace every secret outside local development.
APP_ENV=local
POSTGRES_DB=acm_platform
POSTGRES_USER=acm
POSTGRES_PASSWORD=acm_local_password
REDIS_PASSWORD=redis_local_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_local_password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=8
REGISTER_RATE_LIMIT_IP_ATTEMPTS=10
REGISTER_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
