# Copy to .env for Docker Compose. Replace every secret outside local development.
APP_ENV=local
POSTGRES_DB=acm_platform
POSTGRES_USER=acm
POSTGRES_PASSWORD=acm_local_password
REDIS_PASSWORD=redis_local_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_local_password
MINIO_BUCKET=codearena-submissions
MINIO_SECURE=false
SUBMISSION_SOURCE_MAX_BYTES=262144
SUBMISSION_MIN_INTERVAL_SECONDS=2
JUDGE_SUPPORTED_LANGUAGES=python,cpp
SUBMISSION_STREAM_NAME=codearena:judge:submissions
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_RETRY_MAX_SECONDS=60
OUTBOX_DEDUP_TTL_SECONDS=604800
MINIO_TEST_DATA_BUCKET=codearena-test-data
JUDGE_CONSUMER_GROUP=codearena-judge
JUDGE_CONSUMER_NAME=judge-compose-1
JUDGE_CLAIM_IDLE_MS=60000
JUDGE_LOCK_TTL_MS=600000
SANDBOX_PYTHON_IMAGE=python:3.12-alpine
SANDBOX_CPP_IMAGE=gcc:14.2-bookworm
SANDBOX_PULL_IMAGES=true
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=32
SANDBOX_DISK_LIMIT_BYTES=67108864
SANDBOX_OUTPUT_LIMIT_BYTES=1048576
SANDBOX_OBJECT_LIMIT_BYTES=16777216
SANDBOX_COMPILE_MEMORY_MB=512
SANDBOX_COMPILE_TIMEOUT_SECONDS=20
DOCKER_GID=0
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=8
REGISTER_RATE_LIMIT_IP_ATTEMPTS=10
REGISTER_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CONTENT_TIMEZONE=Asia/Shanghai
CONTENT_SENSITIVE_WORDS=赌博,色情,暴力,违法
DISCUSSION_MAX_REPLY_DEPTH=3
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
