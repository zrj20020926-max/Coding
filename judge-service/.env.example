DATABASE_URL=postgresql+asyncpg://acm:acm_local_password@localhost:5432/acm_platform
REDIS_URL=redis://:redis_local_password@localhost:6379/0
SUBMISSION_STREAM_NAME=codearena:judge:submissions
JUDGE_CONSUMER_GROUP=codearena-judge
JUDGE_CONSUMER_NAME=judge-local-1
JUDGE_CLAIM_IDLE_MS=60000
JUDGE_LOCK_TTL_MS=120000
JUDGE_DATABASE_LEASE_SECONDS=120
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_local_password
MINIO_SOURCE_BUCKET=codearena-submissions
MINIO_TEST_DATA_BUCKET=codearena-test-data
MINIO_SECURE=false
SANDBOX_PYTHON_IMAGE=python:3.12-alpine
SANDBOX_CPP_IMAGE=gcc:14.2-bookworm
SANDBOX_NODE_IMAGE=node:22-alpine
SANDBOX_PULL_IMAGES=true
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=32
SANDBOX_DISK_LIMIT_BYTES=67108864
SANDBOX_OUTPUT_LIMIT_BYTES=1048576
SANDBOX_OBJECT_LIMIT_BYTES=16777216
SANDBOX_COMPILE_MEMORY_MB=512
SANDBOX_COMPILE_TIMEOUT_SECONDS=20
